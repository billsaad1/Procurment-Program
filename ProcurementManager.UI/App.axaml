<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProcurementManager.UI.App">
    <Application.Resources>
        <!-- Custom Color Palette -->
        <SolidColorBrush x:Key="PrimaryDarkBlue" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SecondaryLightBlue" Color="#3498DB"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningOrange" Color="#F39C12"/>
        <SolidColorBrush x:Key="DangerRed" Color="#E74C3C"/>
        <SolidColorBrush x:Key="LightGreyBackground" Color="#ECF0F1"/>
        <SolidColorBrush x:Key="DarkGreyText" Color="#2C3E50"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.xaml"/>

        <!-- Override default styles -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource LightGreyBackground}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkGreyText}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryLightBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBlue}"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C2833"/>
        </Style>

    </Application.Styles>
</Application>
