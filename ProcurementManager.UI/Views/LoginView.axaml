<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProcurementManager.UI.ViewModels"
        x:DataType="vm:LoginViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="ProcurementManager.UI.Views.LoginView"
        Title="Procurement Manager - Login"
        WindowStartupLocation="CenterScreen"
        Width="800" Height="600"
        Background="{StaticResource LightGreyBackground}">

  <Design.DataContext>
    <vm:LoginViewModel/>
  </Design.DataContext>

  <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
    <Border Background="{StaticResource White}"
            CornerRadius="5"
            BoxShadow="0 4 10 #DDDDDD"
            Padding="40"
            Width="350">
      <StackPanel Spacing="15">
        <TextBlock Text="PROCUREMENT"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryDarkBlue}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Login"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBlue}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Text="Username"/>
        <TextBox Text="{Binding Username}" Watermark="Enter your username"/>

        <TextBlock Text="Password"/>
        <TextBox Text="{Binding Password}"
                 PasswordChar="*"
                 Watermark="Enter your password"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerRed}"
                   IsVisible="{Binding !!ErrorMessage}"
                   Margin="0,5"/>

        <Button Content="Login"
                Command="{Binding LoginCommand}"
                Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
