<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProcurementManager.UI.ViewModels"
             x:DataType="vm:SuppliersViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProcurementManager.UI.Views.SuppliersView">
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <Button Content="Add Supplier" Command="{Binding AddSupplierCommand}"/>
      <Button Content="Edit Supplier" Command="{Binding EditSupplierCommand}"/>
      <Button Content="Delete Supplier" Command="{Binding DeleteSupplierCommand}"/>
    </StackPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}" AutoGenerateColumns="False"
              SelectedItem="{Binding SelectedSupplier}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="*"/>
        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
