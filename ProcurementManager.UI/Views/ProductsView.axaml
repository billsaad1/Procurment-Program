<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProcurementManager.UI.ViewModels"
             x:DataType="vm:ProductsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ProcurementManager.UI.Views.ProductsView"
             Background="{StaticResource RegionFillColor}">
  <Border Padding="20" Background="{StaticResource RegionFillColor}">
    <DockPanel LastChildFill="True">

      <!-- Top Section: Title and Buttons -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,15" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="Product &amp; Service Management" VerticalAlignment="Center"
                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextFillColorPrimaryBrush}"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Content="Add Product" Command="{Binding AddProductCommand}" MinWidth="120"
                  Classes="accent"/>
          <Button Content="Edit Product" Command="{Binding EditProductCommand}" MinWidth="120"/>
          <Button Content="Delete Product" Command="{Binding DeleteProductCommand}" MinWidth="120"
                  Classes="danger"/>
        </StackPanel>
      </Grid>

      <!-- Search and Filter Bar -->
      <Border DockPanel.Dock="Top" Margin="0,0,0,15"
              Background="{StaticResource ControlFillColorDefaultBrush}"
              BorderBrush="{StaticResource ControlBorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Filter by:" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBox Watermark="Search by name or SKU..." MinWidth="300"/>
          <!-- TODO: Add filtering by category -->
        </StackPanel>
      </Border>

      <!-- Data Grid -->
      <DataGrid ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct}"
                AutoGenerateColumns="False" IsReadOnly="True"
                GridLinesVisibility="Horizontal" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" SortMemberPath="Name"/>
          <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="150"/>
          <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100"/>
          <DataGridTextColumn Header="Default Price" Binding="{Binding DefaultPrice, StringFormat=C}" Width="120"/>
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
          <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
        </DataGrid.Columns>
      </DataGrid>

    </DockPanel>
  </Border>
</UserControl>
