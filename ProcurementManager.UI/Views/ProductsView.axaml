<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProcurementManager.UI.ViewModels"
             x:DataType="vm:ProductsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProcurementManager.UI.Views.ProductsView">
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <Button Content="Add Product" Command="{Binding AddProductCommand}"/>
      <Button Content="Edit Product" Command="{Binding EditProductCommand}"/>
      <Button Content="Delete Product" Command="{Binding DeleteProductCommand}"/>
    </StackPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" AutoGenerateColumns="False"
              SelectedItem="{Binding SelectedProduct}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="Price" Binding="{Binding DefaultPrice}" Width="*"/>
        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
