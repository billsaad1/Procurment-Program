<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProcurementManager.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ProcurementManager.UI.Views.AddEditInvoiceView"
             x:DataType="vm:AddEditInvoiceViewModel">
    <Design.DataContext>
        <!-- This only sets the design time context for the previewer -->
        <vm:AddEditInvoiceViewModel/>
    </Design.DataContext>
    <StackPanel Spacing="15" Margin="20">
        <TextBlock Text="{Binding Title}" Classes="h2" HorizontalAlignment="Center"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Purchase Order (PO)"/>
            <ComboBox ItemsSource="{Binding PurchaseOrders}"
                      SelectedItem="{Binding SelectedPurchaseOrder}"
                      DisplayMemberBinding="{Binding POID}"
                      PlaceholderText="Select a PO"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Supplier"/>
            <ComboBox ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      DisplayMemberBinding="{Binding Name}"
                      PlaceholderText="Select a Supplier"
                      IsEnabled="{Binding IsSupplierSelectionEnabled}"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Invoice Number"/>
            <TextBox Text="{Binding InvoiceNumber, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Invoice Date"/>
            <DatePicker SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Due Date"/>
            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Amount (before tax)"/>
            <NumericUpDown Value="{Binding Amount, Mode=TwoWay}" Increment="0.01" FormatString="C2"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Tax Amount"/>
            <NumericUpDown Value="{Binding TaxAmount, Mode=TwoWay}" Increment="0.01" FormatString="C2"/>
        </StackPanel>

        <TextBlock Classes="h3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Run Text="Total: "/>
            <Run Text="{Binding TotalAmountDue, StringFormat='C'}"/>
        </TextBlock>
    </StackPanel>
</UserControl>
