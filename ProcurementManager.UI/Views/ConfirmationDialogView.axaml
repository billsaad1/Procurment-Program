<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProcurementManager.UI.ViewModels"
             x:DataType="vm:ConfirmationViewModel"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
             x:Class="ProcurementManager.UI.Views.ConfirmationDialogView">
  <Border Padding="20">
    <DockPanel LastChildFill="False">
      <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,20"/>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Yes" Click="YesButton_Click" IsDefault="True" Classes="accent"/>
        <Button Content="No" Click="NoButton_Click" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
